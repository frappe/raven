{
  "private": true,
  "name": "raven",
  "version": "2.8.11",
  "description": "Messaging Application",
  "workspaces": [
    "apps/web",
    "apps/native",
    "packages/*"
  ],
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "cd apps/web && yarn dev",
    "build": "cd apps/web && yarn build",
    "postinstall": "yarn install-desk && yarn install-web",
    "install-desk": "cd raven && yarn install",
    "install-web": "cd apps/web && yarn install",
    "native:build": "cd apps/web && yarn build:native",
    "native:sync": "yarn native:build && cd apps/native && yarn sync",
    "native:ios": "cd apps/native && yarn ios",
    "native:android": "cd apps/native && yarn android",
    "native:testflight": "cd apps/native && yarn testflight"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "resolutions": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "dependencies": {}
}
